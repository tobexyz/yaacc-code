<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"

        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/contentListBackButton"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="5dp"
            android:contentDescription="@string/icon"
            app:srcCompat="@drawable/ic_baseline_arrow_back_32" />

        <LinearLayout
            android:id="@+id/contentListSortToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/contentListBackButton"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/contentListSortByNameButton"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/sort_by_name"
                app:srcCompat="@drawable/ic_baseline_sort_by_alpha_32"
                app:tint="?attr/colorControlNormal" />

            <ImageButton
                android:id="@+id/contentListSortByDateButton"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/sort_by_date"
                app:srcCompat="@drawable/ic_baseline_date_range_32"
                app:tint="?attr/colorControlNormal" />
        </LinearLayout>

        <!-- layout_below anchors to contentListSortToggle, not
             contentListBackButton: the back button is set to GONE at the
             root folder (ContentListFragment#updateFolderNavigationUi),
             and a GONE view's position collapses to a zero-size point at
             its original top edge, so layout_below="@id/contentListBackButton"
             would snap this label (and everything below it) up to overlap the icon
             row instead of sitting below it. contentListSortToggle is
             never hidden, so it's a stable anchor regardless of
             navigation depth. -->
        <TextView
            android:id="@+id/contentListCurrentFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/contentListSortToggle"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="10dp"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="@string/all"
            android:textAppearance="@android:style/TextAppearance.Material.Medium"
            android:textColor="?android:attr/colorForeground" />

        <View
            android:id="@+id/contentListBottomSeperator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_above="@id/contentListCurrentReceivers"
            android:background="?android:attr/colorForeground" />

        <!-- Receiver bar: selected receivers' names; tap or D-pad select opens
             the device sheet (ContentListFragment#showDeviceSheet). Positioned
             against the parent only: contentListTopSeperator (its old
             toStartOf anchor) is set GONE during a device switch
             (ContentListFragment#hideFolderNavigationControls). The 1dp end
             margin keeps it clear of that vertical separator, as before. -->
        <TextView
            android:id="@+id/contentListCurrentReceivers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="1dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="3"
            android:minHeight="48dp"
            android:paddingStart="5dp"
            android:paddingEnd="8dp"
            android:text="@string/receiver_bar_none_selected"
            android:textAppearance="@android:style/TextAppearance.Material.Medium"
            android:textColor="?android:attr/colorForeground"
            app:drawableEndCompat="@drawable/ic_baseline_expand_less_24"
            app:drawableStartCompat="@drawable/ic_baseline_devices_32" />

        <View
            android:id="@+id/contentListTopSeperator"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_alignEnd="@id/contentListCurrentFolderName"
            android:background="?android:attr/colorForeground" />
    </RelativeLayout>

    <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"

        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contentList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/contentListProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone"
            android:indeterminate="true" />
    </RelativeLayout>
</LinearLayout>