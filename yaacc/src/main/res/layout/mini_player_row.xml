<!-- One row of the mini-player list (MiniPlayerAdapter): a running player's album art, title and
     receiver name, and previous / play-pause / next / stop / exit. Tapping the card opens that player's
     screen. Every text here comes from LAN devices and is set with TextView#setText only: no
     autoLink, no HTML. Neutral card surface from the theme, no accent colors. The card is
     focusable before its buttons, so D-pad reaches the row and then every button of it. Row
     height 56dp + 2 x 2dp margin = 60dp; mini_player_list_max_height is three of them. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardCornerRadius="6dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">

        <ImageView
            android:id="@+id/miniPlayerArt"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/mini_player_art"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Medium"
                android:textColor="?android:attr/colorForeground" />

            <TextView
                android:id="@+id/miniPlayerReceiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Small"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/miniPlayerPrevious"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mini_player_previous"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_baseline_skip_previous_24"
            app:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/miniPlayerPlayPause"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mini_player_play"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_baseline_play_arrow_24"
            app:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/miniPlayerNext"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mini_player_next"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_baseline_skip_next_24"
            app:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/miniPlayerStop"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mini_player_stop"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_baseline_stop_24"
            app:tint="?attr/colorControlNormal" />

        <!-- Removes the player altogether (what the exit button of the player screen does); stop only
             stops the playback and leaves the row. -->
        <ImageButton
            android:id="@+id/miniPlayerExit"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/exit"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_baseline_cancel_32"
            app:tint="?attr/colorControlNormal" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
