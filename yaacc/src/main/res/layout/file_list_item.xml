<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/file_state_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_baseline_play_arrow_24" />

    <CheckBox
        android:id="@+id/file_checkbox"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="5dp"
        android:layout_toEndOf="@id/file_state_icon"
        android:layout_centerVertical="true" />

    <ImageView
        android:id="@+id/file_type_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/file_checkbox"
        android:src="@drawable/ic_baseline_folder_open_24" />

    <TextView
        android:id="@+id/file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/file_type_icon"
        android:padding="5dp"
        android:textAppearance="@android:style/TextAppearance.Material.Medium"
        tools:text="Directory" />
</RelativeLayout>