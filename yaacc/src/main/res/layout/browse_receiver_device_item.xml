<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browseReceiverDeviceItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:descendantFocusability="beforeDescendants"
    android:clickable="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.CardView.List"
        android:id="@+id/item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardUseCompatPadding="true"
        app:contentPadding="12dp">

        <!-- The card is as high as the content column. The album art is laid over the same area by anchoring it to
             the column (a FrameLayout would let the picture's own size make the card tall). -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/browseReceiverDeviceItemAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/yxc_row_content"
                android:layout_alignBottom="@+id/yxc_row_content"
                android:scaleType="centerCrop"
                android:alpha="0.3"
                android:contentDescription="@string/album_art" />

            <LinearLayout
                android:id="@+id/yxc_row_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Device name row with status badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                    android:id="@+id/browseReceiverDeviceItemIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/icon" />

                <TextView
                    android:id="@+id/browseReceiverDeviceItemName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/all"
                    android:textAppearance="@android:style/TextAppearance.Material.Medium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playing"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSecondary"
                    android:background="?attr/colorSecondary"
                    android:padding="4dp"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/browseReceiverDeviceItemCheckbox"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Status text (track info) -->
            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />
            
            <!-- State of a device with group support (power, input, group) -->
            <TextView
                android:id="@+id/yxc_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Group toggle of a device that supports groups: link devices / unlink the group -->
            <LinearLayout
                android:id="@+id/yxc_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/yxc_btn_link"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_yxc_link"
                    android:scaleType="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/yxc_action_link" />

                <!-- Group volume: the average of the members, moves every member by the same number of points -->
                <SeekBar
                    android:id="@+id/yxc_group_volume"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:max="100"
                    android:contentDescription="@string/yxc_group_volume"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/yxc_group_volume_text"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:gravity="center_vertical|end"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Space between the information and the controls; the card is as high as its content -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- Playback controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_baseline_play_arrow_32"
                    app:tint="?attr/colorControlNormal"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/play" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_baseline_pause_32"
                    app:tint="?attr/colorControlNormal"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pause" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_stop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_baseline_stop_32"
                    app:tint="?attr/colorControlNormal"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/stop" />

                <CheckBox
                    android:id="@+id/browseReceiverDeviceItemMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:button="@drawable/sl_mute_32" />

                <SeekBar
                    android:id="@+id/browseReceiverDeviceItemMuteVolumeSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/volume_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/volume_placeholder"
                    android:textSize="12sp" />
            </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>