<!-- The buttons take their colors from the text color and the sheet surface so that they stay readable in the
     light and the dark theme (the AppCompat default primary color is almost black and vanished on the dark
     sheet): Cancel is plain text, OK is filled with the text color. -->
<!-- Content of DeviceSheetFragment in pick mode ("Play on..."). The sheet fits its content (see
     DeviceSheetFragment#applyPickSheetState): the weighted list shrinks when there are more receivers than
     fit on the screen, so the buttons below it stay visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/deviceSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:focusable="false"
        android:text="@string/receiver_pick_title"
        android:textAppearance="@android:style/TextAppearance.Material.Medium"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- The cleaned name of the shared item; shown only when a share is pending. Plain text only. -->
    <TextView
        android:id="@+id/deviceSheetPickSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:ellipsize="middle"
        android:focusable="false"
        android:maxLines="2"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <!-- Shown when confirm is pressed with nothing ticked; announced by TalkBack. -->
    <TextView
        android:id="@+id/deviceSheetPickHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:accessibilityLiveRegion="polite"
        android:focusable="false"
        android:text="@string/receiver_pick_none_hint"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/deviceSheetList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deviceSheetPickCancel"
            android:filterTouchesWhenObscured="true"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deviceSheetPickConfirm"
            android:filterTouchesWhenObscured="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/receiver_pick_confirm"
            android:textColor="?attr/colorSurface"
            app:backgroundTint="?android:attr/textColorPrimary" />
    </LinearLayout>
</LinearLayout>
