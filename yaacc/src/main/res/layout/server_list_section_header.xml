<!-- A section header of the top-level page (SectionHeaderAdapter): a line above it (all but the first
     header), the icon of the kind of device, the label (an accessibility heading) and, for the section
     that offers it, the refresh button. The icon is decorative; the label says what it shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/sectionHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="2dp">

        <ImageView
            android:id="@+id/sectionHeaderIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/sectionHeaderLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Medium"
            android:textColor="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/sectionHeaderRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_devices"
            android:foreground="@drawable/focus_ring"
            android:padding="8dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_baseline_refresh_32"
            app:tint="?attr/colorControlNormal" />
    </LinearLayout>
</LinearLayout>
