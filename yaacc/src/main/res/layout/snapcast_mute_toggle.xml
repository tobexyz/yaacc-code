<!-- The mute of a Snapcast group or client in the sheet: the speaker / muted-speaker symbol of the receiver cards
     (browse_receiver_device_item.xml uses the same drawable), a check box underneath so that it keeps the state and the
     accessibility role. The description and the state text are set in code (SnapcastMuteToggle). -->
<CheckBox xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="48dp"
    android:minHeight="48dp"
    android:button="@drawable/sl_mute_32" />
