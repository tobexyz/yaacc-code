<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <RelativeLayout
        android:id="@+id/contentListHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/contentListBackButton"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="5dp"
            android:contentDescription="@string/icon"
            app:srcCompat="@drawable/ic_baseline_arrow_back_32"
                        app:tint="?attr/colorControlNormal" />

        <LinearLayout
            android:id="@+id/contentListSortToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/contentListSortByNameButton"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/sort_by_name"
                app:srcCompat="@drawable/ic_baseline_sort_by_alpha_32"
                app:tint="?attr/colorControlNormal" />

            <ImageButton
                android:id="@+id/contentListSortByDateButton"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/sort_by_date"
                app:srcCompat="@drawable/ic_baseline_date_range_32"
                app:tint="?attr/colorControlNormal" />

            <ImageButton
                android:id="@+id/contentListViewModeToggle"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/toggle_view_mode"
                app:srcCompat="@drawable/ic_baseline_grid_view_32"
                app:tint="?attr/colorControlNormal" />
        </LinearLayout>

        <TextView
            android:id="@+id/contentListCurrentFolderName"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/contentListSortToggle"
            android:focusable="false"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="@string/all"
            android:textAppearance="@android:style/TextAppearance.Material.Medium"
            android:textColor="?android:attr/colorForeground" />
    </RelativeLayout>

    <View
        android:id="@+id/contentListTopSeperator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/contentListHeaderRow"
        android:background="?android:attr/colorForeground" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/contentListBottomSeperator"
        android:layout_below="@+id/contentListTopSeperator" />

    <ProgressBar
        android:id="@+id/contentListProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:indeterminate="true" />

    <View
        android:id="@+id/contentListBottomSeperator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/contentListCurrentReceivers"
        android:background="?android:attr/colorForeground" />

    <!-- Receiver bar: selected receivers' names; tap or D-pad select opens the
         device sheet (ContentListFragment#showDeviceSheet). Never GONE, so the
         separator and list above can anchor to it. -->
    <TextView
        android:id="@+id/contentListCurrentReceivers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="5dp"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:minHeight="48dp"
        android:paddingStart="5dp"
        android:paddingEnd="8dp"
        android:text="@string/receiver_bar_none_selected"
        android:textAppearance="@android:style/TextAppearance.Material.Medium"
        android:textColor="?android:attr/colorForeground"
        app:drawableEndCompat="@drawable/ic_baseline_expand_less_24"
        app:drawableStartCompat="@drawable/ic_baseline_devices_32" />

</RelativeLayout>