<!-- The mini-player of the new layout (MiniPlayerBar): one compact row (mini_player_row) per
     running player, oldest first like the device sheet's sessions. Hidden (GONE) while no player
     exists. It wraps its rows up to a capped height (MaxHeightRecyclerView, about three rows) and
     scrolls inside beyond that, so many players never push the content away. -->
<de.yaacc.browser.MaxHeightRecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/miniPlayerBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical"
    android:visibility="gone" />
