<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.Bridge">
        <item name="materialTimePickerTheme">@style/ThemeOverlay.App.TimePicker</item>
        <!-- Gray scale: check boxes, switches, sliders, progress bars and the headlines of the settings
             take these instead of the purple and teal defaults -->
        <item name="colorPrimary">@color/gray_primary</item>
        <item name="colorPrimaryVariant">@color/gray_primary_variant</item>
        <item name="colorOnPrimary">@color/gray_on_primary</item>
        <item name="colorSecondary">@color/gray_secondary</item>
        <item name="colorSecondaryVariant">@color/gray_secondary_variant</item>
        <item name="colorOnSecondary">@color/gray_on_secondary</item>
        <item name="colorAccent">@color/gray_accent</item>
        <item name="colorControlActivated">@color/gray_accent</item>
        <item name="android:colorPrimaryDark">@color/gray_primary_variant</item>
    </style>

    <style name="Widget.App.Button.OutlinedButton.IconOnly" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="AppTheme.FullScreenDialog" parent="AppTheme" />

    <style name="AppTheme.Slide">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="ThemeOverlay.App.TimePicker" parent="@style/ThemeOverlay.MaterialComponents.TimePicker" />

    <!-- Device sheet (BottomSheetDialogFragment#getTheme). AppTheme's Bridge
         parent sets no bottomSheetDialogTheme, so without this the dialog falls
         back to the light Theme.Design one. This is an overlay: colors still
         come from AppTheme (DayNight), the sheet tints with ?attr/colorSurface. -->
    <style name="ThemeOverlay.App.DeviceSheet" parent="@style/ThemeOverlay.MaterialComponents.BottomSheetDialog" />

</resources>