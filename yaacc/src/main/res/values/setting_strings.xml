    <string name="settings_snapcast_category">Snapcast</string>
    <string name="settings_snapcast_play_experimental_title">Play to Snapcast groups</string>
    <string name="settings_snapcast_play_experimental_summary">Music from the player is sent to a Snapcast server so that a group plays it. The audio is sent unencrypted to the server.</string>
    <string name="settings_snapcast_play_experimental" translatable="false">settings_snapcast_play_experimental</string>
    <string name="settings_snapcast_discovery_title">Find Snapcast servers</string>
    <string name="settings_snapcast_discovery_summary">Searches the local network for Snapcast servers; on by default. It sends mDNS queries on the network and contacts every server that announces itself there. Announcements are not authenticated: any device on the network can announce a server. Clear the checkbox on networks you do not trust. Off: only the servers listed below are used.</string>
    <string name="settings_snapcast_servers_title">Snapcast servers</string>
    <string name="settings_snapcast_servers_summary">Add servers by address, or remove them</string>
    <string name="settings_snapcast_about_title">What Snapcast needs</string>
    <string name="settings_snapcast_about_summary">YAACC plays into an existing Snapcast server; it needs one reachable on your network.</string>
    <string name="settings_snapcast_discovery" translatable="false">settings_snapcast_discovery</string>
    <string name="settings_snapcast_servers" translatable="false">settings_snapcast_servers</string>
    <string name="settings_snapcast_client_title">Snapcast client</string>
    <string name="settings_snapcast_client_summary">Lets this phone act as a Snapcast client: adds the Snapcast client switch to the first page and its card. Off by default. Audio and control are sent unencrypted.</string>
    <string name="settings_snapcast_client_open_title">Snapcast client details</string>
    <string name="settings_snapcast_client_open_summary">Shows the connection state, the sync values and the event trace of this client, for troubleshooting.</string>
    <string name="settings_snapcast_client_switched_on_title">Connected to the Snapcast server</string>
    <string name="settings_snapcast_client_switched_on_summary_on">This phone is connected to a Snapcast server and plays as a client.</string>
    <string name="settings_snapcast_client_switched_on_summary_off">This phone is not connected to a Snapcast server.</string>
    <string name="settings_snapcast_client_switched_on_summary_waiting">Switched on, but not connected to a server right now. The client details say why.</string>
    <string name="settings_snapcast_client_switched_on" translatable="false">settings_snapcast_client_switched_on</string>
    <string name="settings_snapcast_client" translatable="false">settings_snapcast_client</string>
    <string name="settings_snapcast_client_open" translatable="false">settings_snapcast_client_open</string>
    <string name="settings_renderer_output_title">Output</string>
    <string name="settings_renderer_output_summary">Snapcast group: the receiver only feeds the group (audio only), this phone stays silent. The audio is sent unencrypted to the server. Any device that can reach the receiver can change the volume and mute of the whole group.</string>
