    <string name="settings_snapcast_category">Snapcast</string>
    <string name="settings_snapcast_play_experimental_title">向 Snapcast 组播放</string>
    <string name="settings_snapcast_play_experimental_summary">播放器的音乐会发送到 Snapcast 服务器，由某个组播放。音频以未加密方式发送到服务器。</string>
    <string name="settings_snapcast_discovery_title">查找 Snapcast 服务器</string>
    <string name="settings_snapcast_discovery_summary">在本地网络中搜索 Snapcast 服务器，默认开启。它会通过网络发送 mDNS 查询，并连接网络中所有主动声明自己的服务器。这些声明未经身份验证：网络中的任何设备都可以声明一个服务器。在你不信任的网络上请取消勾选。关闭时：只使用下方列出的服务器。</string>
    <string name="settings_snapcast_servers_title">Snapcast 服务器</string>
    <string name="settings_snapcast_servers_summary">按地址添加服务器，或移除服务器</string>
    <string name="settings_snapcast_about_title">Snapcast 的要求</string>
    <string name="settings_snapcast_about_summary">YAACC 向现有的 Snapcast 服务器播放；你的网络中需要有一台可访问的服务器。</string>
    <string name="settings_snapcast_client_title">Snapcast 客户端</string>
    <string name="settings_snapcast_client_summary">让本手机作为 Snapcast 客户端工作：在首页添加 Snapcast 客户端开关及其卡片。默认关闭。音频和控制未加密传输。</string>
    <string name="settings_snapcast_client_open_title">Snapcast 客户端详情</string>
    <string name="settings_snapcast_client_open_summary">显示此客户端的连接状态、同步数据和事件记录，用于排查问题。</string>
    <string name="settings_snapcast_client_switched_on_title">已连接到 Snapcast 服务器</string>
    <string name="settings_snapcast_client_switched_on_summary_on">本手机已连接到 Snapcast 服务器，并作为客户端播放。</string>
    <string name="settings_snapcast_client_switched_on_summary_off">本手机未连接到 Snapcast 服务器。</string>
    <string name="settings_snapcast_client_switched_on_summary_waiting">已开启，但目前未连接到服务器。客户端详情会说明原因。</string>
    <string name="settings_renderer_output_title">输出</string>
    <string name="settings_renderer_output_summary">Snapcast 组：接收器只向该组输送音频（仅限音频），本手机保持静音。音频以未加密方式发送到服务器。任何能访问该接收器的设备都可以更改整个组的音量和静音。</string>
