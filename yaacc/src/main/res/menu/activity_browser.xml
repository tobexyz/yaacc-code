<!-- Toolbar of the new layout. The ids are shared with menu/activity_main.xml on purpose:
     BrowserActivitySupport handles settings, log, about and exit for both layouts. -->
<menu xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked while a timer runs; BrowserActivity shows the remaining time as its title then. -->
    <item
        android:id="@+id/menu_shutdown_timer"
        android:checkable="true"
        android:icon="@drawable/ic_baseline_timer_24"
        android:orderInCategory="90"
        android:title="@string/shutdown_timer"
        app:showAsAction="ifRoom" />
    <item
        android:id="@+id/menu_settings"
        android:orderInCategory="100"
        android:title="@string/title_activity_settings"
        app:showAsAction="never" />
    <item
        android:id="@+id/yaacc_log"
        android:orderInCategory="110"
        android:title="@string/title_activity_yaacc_log"
        app:showAsAction="never" />
    <item
        android:id="@+id/yaacc_about"
        android:orderInCategory="120"
        android:title="@string/yaacc_about"
        app:showAsAction="never" />
    <item
        android:id="@+id/menu_exit"
        android:icon="@drawable/ic_exit_to_app_24"
        android:orderInCategory="130"
        android:title="@string/exit"
        app:showAsAction="always" />
</menu>
