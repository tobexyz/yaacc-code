<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
         Exposes only getCacheDir()/shared/ (where ShareContentHelper
         downloads a copy of the shared item before handing it to another
         app) - nothing else under the app's cache or files directories is
         reachable through this provider.
    -->
    <cache-path name="shared_files" path="shared/" />
</paths>
