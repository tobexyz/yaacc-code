<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is off (allowBackup=false): nothing is copied to the cloud or to a new device. The
     rules say the same for Android 12 and later, which reads this file instead of allowBackup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
